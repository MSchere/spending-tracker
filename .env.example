# =============================================================================
# Spending Tracker - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# SQLite file path (relative to project root, or absolute)
DATABASE_URL="file:./prisma/database.db"

# -----------------------------------------------------------------------------
# NextAuth Configuration
# -----------------------------------------------------------------------------
# The URL where your app is hosted
NEXTAUTH_URL="http://localhost:3000"

# Secret for signing JWTs (min 32 chars, generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="your-nextauth-secret-min-32-chars-here"

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Encryption key for 2FA secrets (must be exactly 32 characters)
# Generate with: openssl rand -base64 24 | head -c 32
ENCRYPTION_KEY="your-32-character-encryption-key"

# -----------------------------------------------------------------------------
# Wise API Configuration
# -----------------------------------------------------------------------------
# Get your API token from: https://wise.com/settings/api-tokens
WISE_API_TOKEN="your-wise-personal-api-token"

# API environment: "sandbox" for testing, "production" for real data
WISE_ENVIRONMENT="production"

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Spending Tracker"
NODE_ENV="development"

# -----------------------------------------------------------------------------
# Alpha Vantage API (optional - for stocks/crypto prices)
# -----------------------------------------------------------------------------
# Get your free API key from: https://www.alphavantage.co/support/#api-key
# Free tier: 25 requests/day
ALPHA_VANTAGE_API_KEY="your-alpha-vantage-api-key"

# -----------------------------------------------------------------------------
# Indexa Capital API (optional - for index fund tracking)
# -----------------------------------------------------------------------------
# API token from Indexa Capital
INDEXA_API_TOKEN=""
# Login credentials (alternative to API token)
INDEXA_USERNAME=""
INDEXA_PASSWORD=""
# Document ID (DNI/NIE)
INDEXA_DOCUMENT=""

# -----------------------------------------------------------------------------
# Interactive Brokers Web API (optional - for IBKR positions)
# -----------------------------------------------------------------------------
# URL of the Client Portal Gateway (Java binary in ibkr/, started with
# `bin/run.sh root/conf.yaml`). Serves self-signed HTTPS on port 5000.
# After starting the gateway, open this URL in a browser and log in with your
# IBKR credentials + 2FA. Sessions last ~24h and need periodic re-login.
# In docker-compose this points at the gateway service instead.
IBKR_GATEWAY_URL="https://localhost:5000"
# Browser-facing URL of the gateway, used for re-login links in the UI.
# Set this when the app runs in Docker (gateway URL is the internal service name):
# IBKR_GATEWAY_PUBLIC_URL="https://192.168.10.150:5000"

# -----------------------------------------------------------------------------
# Docker Deployment (optional)
# -----------------------------------------------------------------------------
# Port to expose the app on the host
APP_PORT="3000"
