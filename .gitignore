# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Docker backup files (contain sensitive data)
/docker/backup

# SQLite database files
*.db
*.db-shm
*.db-wal

# IBKR Client Portal Gateway — binaries are downloaded at build/dev time
# (ibkr/fetch-gateway.sh or the image build); only our config is committed
ibkr/bin/
ibkr/build/
ibkr/dist/
ibkr/doc/
ibkr/logs/
ibkr/.vertx/
ibkr/root/webapps/
ibkr/root/demo.zip
ibkr/root/vertx.jks
ibkr/root/logback.xml
ibkr/root/conf.alpha.yaml
ibkr/root/conf.api.alpha.yaml
ibkr/root/conf.beta.yaml
ibkr/root/conf.tws.yaml

# Local DB backups
*.db.bak
